PORT=3001

# --- Required: use a paid/mainnet RPC OR Helius for speed ---
# Option A (recommended): Helius RPC + REST tx history
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY
HELIUS_API_KEY=YOUR_HELIUS_KEY
HELIUS_TX_LIMIT=100

# Option B: other provider
# SOLANA_RPC_URL=https://your-quicknode-url

# Scan speed: fast (default, ~2-5s) | balanced (~5-10s) | deep (slow, more history)
SCAN_MODE=fast

# Token/Rug scans add 5-15s — disabled automatically in fast mode
SKIP_EXTERNAL_SCANS=true

# Only used when SCAN_MODE=deep or balanced
SIGNATURE_PAGE_SIZE=1000
MAX_SIGNATURE_PAGES=15
SIGNATURE_PAGE_DELAY_MS=200
RPC_MAX_RETRIES=3
RPC_RETRY_BASE_MS=800

# Optional integrations (not required for core wallet check)
RUGCHECK_API_KEY=
SOLSNIFFER_API_KEY=
TOKENSNIFFER_API_KEY=
MAX_TOKEN_SCANS=3
