PORT=3001
# Comma-separated frontend origins for cross-origin hosting; empty for same-origin proxy.
CORS_ALLOWED_ORIGINS=

# --- Mainnet RPC: Helius Free is suitable for quota-limited testing ---
# Option A (recommended): Helius RPC + REST tx history
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY
# Dedicated endpoint for signature pagination (wallet age). Defaults to SOLANA_RPC_URL.
SOLANA_HISTORY_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY
HELIUS_API_KEY=YOUR_HELIUS_KEY
HELIUS_TX_LIMIT=100

# Option B: other provider
# SOLANA_RPC_URL=https://your-quicknode-url

# Scan speed: fast (default, ~2-5s) | balanced (~5-10s) | deep (slow, more history)
SCAN_MODE=fast

# Token scans have a shared 8-second deadline; false explicitly enables them in fast mode
SKIP_EXTERNAL_SCANS=true

# Page size applies to signature pagination in all modes
SIGNATURE_PAGE_SIZE=1000
# Transaction page cap override applies only in deep mode
MAX_SIGNATURE_PAGES=15
# Optional: higher limit only for wallet-age fallback pagination (Helius asc=1 skips this)
MAX_AGE_SIGNATURE_PAGES=100
# Transaction page delay override applies only in deep mode
SIGNATURE_PAGE_DELAY_MS=200
RPC_MAX_RETRIES=5
RPC_RETRY_BASE_MS=800
# Batch sybil scan: limit parallel wallets + in-flight RPC calls
SYBIL_SCAN_CONCURRENCY=2
RPC_GLOBAL_CONCURRENCY=6
# Funding trace fallback (Helius GTFA uses 1 call when HELIUS_API_KEY is set)
FUNDING_MAX_SIGNATURE_PAGES=50
FUNDING_PAGE_DELAY_MS=250

# Optional integrations (not required for core wallet check)
# Optional key from FluxRPC > RugCheck > API Keys (not the Solana RPC key).
# Sent as X-API-KEY. For a JWT use "Bearer <jwt>". Empty uses public access.
# A rejected credential (401) retries the official public endpoint without it.
RUGCHECK_API_KEY=
# SolSniffer Free: 100 calls/month; key sent via X-API-KEY.
# Per-process attempt guard (0 disables new calls, max 100); resets on restart.
SOLSNIFFER_MAX_CALLS_PER_RUN=90
SOLSNIFFER_API_KEY=
MAX_TOKEN_SCANS=3

# Optional provider endpoint overrides (keep /api/v2 for SolSniffer).
# RUGCHECK_BASE_URL=https://api.rugcheck.xyz
# SOLSNIFFER_BASE_URL=https://solsniffer.com/api/v2

# Public-service limits (single API instance; see render.yaml for the deployment preset)
CACHE_TTL_SECONDS=300
CACHE_MAX_WALLETS=256
WALLET_TIMEOUT_SECONDS=45
REQUEST_TIMEOUT_SECONDS=120
MAX_ACTIVE_REQUESTS=8
MAX_ACTIVE_SCANS=4
# One single scan costs 1 request unit; a batch costs 10, even when cached.
IP_SCAN_UNITS_PER_MINUTE=30
# Counts new wallet scans, including failed attempts, not individual provider calls.
FRESH_SCANS_PER_HOUR=120
# Leave empty unless you control a proxy that overwrites X-WalletGuard-Client-IP.
# Only exact socket peer IPs listed here may supply that header.
TRUSTED_PROXY_IPS=
# Optional path containing built frontend files; root Dockerfile sets this.
# STATIC_DIR=../frontend/dist
